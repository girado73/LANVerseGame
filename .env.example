# Local development environment – copy to `.env` (gitignored) and adjust.
# `dev-up.sh` loads this file; `cargo run` does not read it by itself, so
# either source it in your shell or use the script.

# docker compose services (see docker-compose.yml)
LANBASH_DATABASE_URL=postgres://lanverse:lanverse@127.0.0.1:5432/lanverse
LANBASH_REDIS_URL=redis://127.0.0.1:6379/2

# Local-only secrets. Replace with real ones outside a laptop.
LANBASH_RESULT_SECRET=dev-only-not-a-secret-0123456789abcdef
LANBASH_ADMIN_KEY=dev-admin
